# Wonder Baboon — clean URLs on Apache/LiteSpeed (Hostinger shared hosting)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One canonical host (API CORS + Razorpay are configured for wonderbaboon.com)
  RewriteCond %{HTTP_HOST} ^www\.wonderbaboon\.com$ [NC]
  RewriteRule ^ https://wonderbaboon.com%{REQUEST_URI} [R=301,L]

  # Legacy dashboard → Your trips (before generic .html redirects)
  RewriteRule ^user-dashboard\.html$ /upcoming-trips [R=301,L,NC]
  RewriteRule ^user-dashboard/?$ /upcoming-trips [R=301,L,NC]

  # External request: /page.html → /page (301, keeps bookmarks working)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # Internal: /page → page.html (address bar stays clean)
  RewriteRule ^upcoming-trips/?$ upcoming-trips.html [L,NC]
  RewriteRule ^previous-trips/?$ previous-trips.html [L,NC]
  # Travel Gallery (clean URL — no extra rule needed beyond this line)
  RewriteRule ^previous-adventures/?$ previous-adventures.html [L,NC]
  RewriteRule ^settings/?$ settings.html [L,NC]
  RewriteRule ^auth/?$ auth.html [L,NC]
  RewriteRule ^admin-dashboard/?$ admin-dashboard.html [L,NC]
  RewriteRule ^backpackers/?$ backpackers.html [L,NC]
  RewriteRule ^motorcycle-diaries/?$ motorcycle-diaries.html [L,NC]
  RewriteRule ^dolce-far-niente/?$ dolce-far-niente.html [L,NC]
  RewriteRule ^hikers/?$ hikers.html [L,NC]

  # Legacy favicon paths → current files (bookmarks + Google default /favicon.ico)
  RewriteRule ^favicon\.ico$ wb-favicon.ico [L,NC]
  RewriteRule ^favicon-48\.png$ wb-favicon-48.png [L,NC]
</IfModule>

DirectoryIndex index.html

# Cache: HTML + version manifest always revalidate; assets use browser cache until ?v= changes.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(version\.json|version-check\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "^(wb-favicon.*|favicon.*|apple-touch-icon.*)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# ── SEO / performance (compression, caching, safe security headers) ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/ld+json image/svg+xml text/xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 week"
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # Safe CSP subset: blocks plugins, <base> hijacking, framing by other sites and form posts elsewhere.
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
  <FilesMatch "^(sitemap\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "^admin-dashboard\.html$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# ── Never serve source, tooling or hidden files ──
<IfModule mod_rewrite.c>
  RewriteRule ^(node_modules|src|scripts|backend|\.git)(/|$) - [F,L,NC]
</IfModule>
<IfModule mod_authz_core.c>
<FilesMatch "(^\.|\.(ts|map|env|ini|log|bak|sql|py|sh|md)$|^(package(-lock)?\.json|tsconfig\.json|serve\.json)$)">
  Require all denied
</FilesMatch>
</IfModule>
